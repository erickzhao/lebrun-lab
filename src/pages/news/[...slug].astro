---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PostNav from '../../components/PostNav.astro'

/*
 * Newest first, the same order the News index lists them, so the neighbours
 * offered here are the rows above and below the one the reader came from.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = (await getCollection('news')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  )

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }))
}

interface Props {
  post: CollectionEntry<'news'>
  newer?: CollectionEntry<'news'>
  older?: CollectionEntry<'news'>
}

const { post, newer, older } = Astro.props

/*
 * "Previous" and "next" have no fixed meaning in a list that runs backwards
 * through time, so these say which way they go.
 */
const toLink = (entry?: CollectionEntry<'news'>) =>
  entry && { href: `/news/${entry.id}/`, title: entry.data.title }
const { Content } = await render(post)

/*
 * The description is the standfirst, and for most posts it is a line or two.
 * For a few it is the whole article: Dr. Lebrun writes the piece into the
 * summary field and leaves the body for the photograph and the links. At
 * standfirst size that runs to twenty-odd lines of 24px display type, which
 * reads as shouting rather than as an introduction.
 *
 * So the length chooses the treatment. Anything longer than a standfirst is
 * set as lead copy at reading size, and blank lines in the field are honoured
 * as paragraph breaks either way.
 */
const LEAD_THRESHOLD = 300
const description = post.data.description?.trim() ?? ''
const paragraphs = description.split(/\n+/).map((p) => p.trim()).filter(Boolean)
const isLead = description.length > LEAD_THRESHOLD

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<Base title={post.data.title} description={post.data.description}>
  <header class="page page--measure post-head">
    <div>
      <p class="eyebrow meta">
        <a href="/news/" class="back">← News</a> ·{' '}
        <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
      </p>
      <h1>{post.data.title}</h1>
      {
        paragraphs.length > 0 && (
          <div class:list={['post-sub', { 'is-lead': isLead }]}>
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <section class="page page--measure band">
    <div class="prose">
      <Content />
    </div>
  </section>

  <PostNav
    previous={toLink(newer)}
    next={toLink(older)}
    labels={{ previous: 'Newer', next: 'Older' }}
  />
</Base>

<style>
  .post-head {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .post-head > div {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-head h1 {
    font-size: var(--size-title);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .back {
    color: var(--slate);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .post-sub p {
    margin: 0;
    font-family: var(--display-family);
    font-size: clamp(1.25rem, 1.1rem + 0.64vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--slate);
  }

  /* Lead copy is read, not scanned, so it takes the body face and size. */
  .post-sub.is-lead p {
    font-family: var(--body-family);
    font-size: var(--size-body);
    line-height: 1.7;
    letter-spacing: normal;
    color: var(--ink);
  }

  .post-sub p + p {
    margin-top: 1.25rem;
  }
</style>
