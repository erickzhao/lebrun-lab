---
import { getCollection, getEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageIntro from '../../components/PageIntro.astro'
import RowArrow from '../../components/RowArrow.astro'
import { excerpt } from '../../lib/excerpt'

const info = await getEntry('pages', 'news')
const { title, subtitle } = info?.data ?? {}

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<Base title={title} description={subtitle}>
  <PageIntro eyebrow="News" title={title} subtitle={subtitle} />

  <section class="page band">
    <div class="rule-list">
      {
        posts.map((post) => {
          // Most posts carry a description; the few that do not fall back to
          // the opening of the body rather than showing an empty row.
          const summary = post.data.description?.trim() || excerpt(post.body ?? '', 240).text
          return (
            <a class="quiet post" href={`/news/${post.id}/`}>
              <time class="meta" datetime={post.data.date.toISOString()}>
                {dateFormat.format(post.data.date)}
              </time>
              <div class="post-body">
                <span class="post-title">{post.data.title}</span>
                {summary && <p class="post-summary">{summary}</p>}
              </div>
              <RowArrow />
            </a>
          )
        })
      }
    </div>
  </section>
</Base>

<style>
  .post {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 20px;
    gap: 32px;
    padding: 26px 0;
  }

  /* The date carries the accent here, where it is the thing being scanned. */
  .post time {
    padding-top: 6px;
    color: var(--accent);
  }

  /* These rows run to three lines, so the arrow sits on the headline rather
     than in the middle of the summary under it. */
  .post :global(.row-arrow) {
    margin-top: 7px;
    color: var(--accent);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .post-title {
    font-family: var(--display-family);
    font-size: 1.375rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .post-summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--slate);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .post {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 20px 0;
    }

    /* One column, so the arrow would land under the summary. */
    .post :global(.row-arrow) {
      display: none;
    }

    .post time {
      padding-top: 0;
    }

    .post-title {
      font-size: 1.1875rem;
      line-height: 1.3;
    }
  }
</style>
