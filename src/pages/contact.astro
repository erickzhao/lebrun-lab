---
import { marked } from 'marked'
import { getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageIntro from '../components/PageIntro.astro'
import Map from '../components/Map.astro'
import { normalizeEmail } from '../lib/email'

const entry = await getEntry('pages', 'contact')
if (!entry) throw new Error('Missing src/content/pages/contact.md')

const { title, subtitle, contact, address, directions } = entry.data

const lines = [
  address?.line1,
  address?.line2,
  [address?.city, address?.province].filter(Boolean).join(', '),
  address?.postalCode,
].filter((line): line is string => Boolean(line))

const email = contact?.email ? normalizeEmail(contact.email) : undefined
const phone = contact?.phone?.trim()
---

<Base title={title} description={subtitle}>
  <PageIntro eyebrow="Contact" title={title} subtitle={subtitle} displaySubtitle />

  <section class="page band details">
    <div class="field">
      <p class="meta">Point of contact</p>
      {contact?.name && <p class="field-name">{contact.name}</p>}
      {contact?.position && <p class="field-note">{contact.position}</p>}
      {email && (
        <p>
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      )}
      {phone && (
        <p>
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a>
        </p>
      )}
    </div>

    {
      lines.length > 0 && (
        <div class="field">
          <p class="meta">Address</p>
          <address>
            {lines.map((line, index) => (
              <>
                {line}
                {index < lines.length - 1 && <br />}
              </>
            ))}
          </address>
        </div>
      )
    }
  </section>

  {
    lines.length > 0 && (
      <section class="page band">
        <p class="eyebrow meta">Map</p>
        <div class="map">
          <Map address={lines.join(', ')} />
        </div>
      </section>
    )
  }

  {
    directions && (
      <section class="page band">
        <p class="eyebrow meta">Directions</p>
        <div class="directions prose" set:html={marked.parse(directions)} />
      </section>
    )
  }
</Base>

<style>
  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
  }

  .field p {
    margin: 0;
  }

  .field-name {
    font-family: var(--display-family);
    font-size: var(--size-card);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .field-note {
    color: var(--slate);
    font-size: 1rem;
    line-height: 1.6;
  }

  .field address {
    font-style: normal;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .map {
    margin-top: 1.5rem;
  }

  .directions {
    margin-top: 1.5rem;
    max-width: var(--measure);
  }

  /* The directions are a bullet list, one line per mode of transport. */
  .directions :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .directions :global(li) {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .directions :global(li + li) {
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .details {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
