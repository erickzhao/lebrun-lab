---
import { marked } from 'marked'
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { splitHome } from '../lib/homeSections'

const home = await getEntry('pages', 'home')
if (!home) throw new Error('Missing src/content/pages/home.md')

const { lead, prose, sponsors } = splitHome(home.body ?? '')

/**
 * Every research topic goes in the rail, in the order the collection returns
 * them, so the CMS ordering is the running order and there is no featured set
 * to choose. Three fit on screen at a time with the fourth peeking out.
 */
const topics = await getCollection('research')

const LATEST_NEWS = 4
const posts = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, LATEST_NEWS)

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})

/**
 * The lead photograph. `headerImage` on the Home entry is the CMS field for it;
 * until one is chosen there, the site falls back to the panoramic photograph of
 * the Glen site that the Contact and Lab members pages already use.
 */
const DEFAULT_LEAD_IMAGE = '/img/new panoramic glen-blue-sky - low res.jpg'
const leadImage = home.data.headerImage || DEFAULT_LEAD_IMAGE
const leadCaption = home.data.headerCaption
---

<Base description="The Lebrun Lab studies the molecular mechanisms behind tumour initiation, progression, stemness and drug resistance in metastatic cancer, at the Research Institute of the McGill University Health Centre.">
  <figure class="lead">
    <div class="figure-wide">
      <img src={leadImage} alt="" fetchpriority="high" decoding="async" />
    </div>
    <figcaption class="page">
      <div class="figure-caption">
        <span class="meta">{leadCaption}</span>
        <span class="meta">Lebrun Lab</span>
      </div>
    </figcaption>
  </figure>

  <section class="page masthead-band">
    <h1>Lebrun Laboratory</h1>
    {lead && <p class="mission">{lead}</p>}
  </section>

  <section class="page band research">
    <p class="eyebrow meta">Research</p>
    <a class="all-link" href="/research/">All {topics.length} research areas</a>

    <!--
      Hidden until the script reveals them: the rail below is a real scroll
      container, so it works by swipe, trackpad and keyboard on its own, and a
      visitor without JavaScript should never be shown a control that does
      nothing.
    -->
    <div class="arrows" hidden>
      <button type="button" class="arrow" data-rail-step="-1" aria-label="Previous research topics" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
      </button>
      <button type="button" class="arrow" data-rail-step="1" aria-label="Next research topics">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
    </div>

    <ul class="rail" id="researchRail" tabindex="0" role="group" aria-label="Research topics, scrollable">
      {
        topics.map((topic) => (
          <li>
            <a class="quiet topic" href={`/research/${topic.id}/`}>
              <div class="topic-figure">
                {topic.data.headerImage && (
                  <img src={topic.data.headerImage} alt="" loading="lazy" decoding="async" />
                )}
              </div>
              <h2>{topic.data.title.trim()}</h2>
              {topic.data.subtitle && <p class="topic-sub">{topic.data.subtitle}</p>}
              {topic.data.tags && topic.data.tags.length > 0 && (
                <p class="tags meta">
                  {topic.data.tags.slice(0, 4).map((tag, index) => (
                    <>
                      {index > 0 && <span class="sep">·</span>}
                      <span>{tag}</span>
                    </>
                  ))}
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="track" aria-hidden="true"><span class="thumb"></span></div>
  </section>

  <section class="page band">
    <div class="section-head">
      <p class="eyebrow meta">Latest news</p>
      <a href="/news/">All news</a>
    </div>
    <div class="rule-list news">
      {
        posts.map((post) => (
          <a class="quiet news-row" href={`/news/${post.id}/`}>
            <time class="meta" datetime={post.data.date.toISOString()}>
              {dateFormat.format(post.data.date)}
            </time>
            <span class="news-title">{post.data.title}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    prose && (
      <section class="page page--measure band">
        <div class="prose" set:html={marked.parse(prose)} />
      </section>
    )
  }

  {
    sponsors && (
      <section class="page band">
        <p class="eyebrow meta">{sponsors.heading}</p>
        <div class="sponsors">
          {sponsors.logos.map((logo) => (
            <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .lead {
    margin: 0;
  }

  .masthead-band {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem) clamp(3.5rem, 2rem + 6vw, 7rem);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: min(var(--page-max), 61.25rem);
  }

  .masthead-band h1 {
    font-size: var(--size-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .mission {
    margin: 0;
    font-family: var(--display-family);
    font-size: clamp(1.3125rem, 1.05rem + 1.09vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 26em;
  }

  .section-head {
    margin-bottom: 2.5rem;
  }

  /* ------------------------------------------------ research rail -- */

  /*
   * A grid so the "All N research areas" link can sit under the eyebrow on
   * desktop and below the track on mobile without being written twice.
   */
  .research {
    --card: 312px;
    --rail-gap: 32px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    row-gap: 16px;
    column-gap: 24px;
  }

  .research .eyebrow {
    grid-column: 1;
    grid-row: 1;
  }

  .all-link {
    grid-column: 1;
    grid-row: 2;
    justify-self: start;
    font-size: 0.9375rem;
  }

  .arrows {
    grid-column: 2;
    grid-row: 1 / 3;
    display: flex;
    gap: 8px;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }

  .arrow:hover:not(:disabled) {
    border-color: var(--ink);
  }

  .arrow:disabled {
    color: #b9c0c9;
    cursor: default;
  }

  /*
   * The rail is a native scroll container, not a transform slider: it scrolls
   * by swipe, trackpad and arrow key with no script at all, and every topic is
   * a real link in the document whether or not the buttons work.
   */
  .rail {
    grid-column: 1 / -1;
    grid-row: 3;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    gap: var(--rail-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  /*
   * With no script the arrows stay hidden, so the scrollbar is the only
   * remaining affordance for a mouse — give it back.
   */
  :global(html.no-js) .rail {
    scrollbar-width: thin;
  }

  :global(html.no-js) .rail::-webkit-scrollbar {
    display: block;
    height: 8px;
  }

  .rail > li {
    flex: 0 0 var(--card);
    scroll-snap-align: start;
  }

  .topic {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .topic-figure {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--tile);
    overflow: hidden;
  }

  .topic-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /*
   * Titles run from "MicroRNAs in Cancer" to a hundred characters, and a flex
   * row is as tall as its tallest card, so the longest title would otherwise
   * set the height of the whole rail.
   */
  .topic h2 {
    margin-top: 4px;
    font-size: 1.5rem;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /*
   * Two of the ten subtitles are a full paragraph rather than a line, and one
   * over-long card would otherwise set the height of every card in the row.
   */
  .topic-sub {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--slate);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /*
   * Four of the ten topics carry a long semicolon-separated keyword string
   * rather than a few short tags. Two lines is the cap, and the height is an
   * exact multiple of the line box so the cut lands between lines instead of
   * slicing one in half. Plain inline flow rather than a wrapping flex row:
   * a flex row-gap would put the cut back off the line boundary. The markup
   * caps the strip at four tags for the same reason — only one topic carries
   * more than four, and without the cap its row ends mid-word. The full set
   * is on the topic page.
   */
  .tags {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.7;
    max-height: 3.4em;
    overflow: hidden;
  }

  .sep {
    color: #b5b0a8;
    margin-inline: 6px;
  }

  .track {
    grid-column: 1 / -1;
    grid-row: 4;
    margin-top: 24px;
    height: 2px;
    background: var(--rule);
  }

  .thumb {
    display: block;
    height: 2px;
    width: 33%;
    background: var(--ink);
  }

  .news-row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    align-items: baseline;
    padding: 22px 0;
  }

  .news-title {
    font-family: var(--display-family);
    font-size: 1.375rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .sponsors {
    margin-top: 1.75rem;
    display: flex;
    gap: 48px;
    align-items: center;
    padding: 32px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .sponsors img {
    flex: 1;
    min-width: 0;
    max-height: 90px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .research {
      --card: 240px;
      --rail-gap: 20px;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }

    /* Swipe only below this width, as the board has it. */
    .arrows {
      display: none;
    }

    .rail {
      grid-row: 2;
      margin-top: 0;
    }

    .track {
      grid-row: 3;
      margin-top: 20px;
    }

    .all-link {
      grid-row: 4;
    }

    .topic h2 {
      font-size: 1.1875rem;
    }

    .topic-sub {
      font-size: 0.875rem;
    }

    .tags {
      display: none;
    }

    .news-row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 18px 0;
    }

    .news-title {
      font-size: 1.1875rem;
      line-height: 1.3;
    }

    .sponsors {
      flex-wrap: wrap;
      gap: 24px;
    }
  }
</style>

<script>
  const rail = document.getElementById('researchRail')
  const section = rail?.closest('.research')
  const arrows = section?.querySelector<HTMLElement>('.arrows')
  const thumb = section?.querySelector<HTMLElement>('.thumb')

  if (rail && arrows && thumb) {
    const buttons = Array.from(arrows.querySelectorAll<HTMLButtonElement>('.arrow'))

    // The controls do something now, so they can be shown.
    arrows.hidden = false

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

    // One card plus its gap — read from the DOM so the two breakpoints and any
    // future card size stay correct without being repeated here.
    const step = () => {
      const card = rail.querySelector('li')
      const gap = parseFloat(getComputedStyle(rail).columnGap) || 0
      return (card?.getBoundingClientRect().width ?? 0) + gap
    }

    const maxScroll = () => rail.scrollWidth - rail.clientWidth

    const sync = () => {
      const max = maxScroll()
      // A sub-pixel scrollLeft is normal after a snap, so leave a little slack.
      buttons[0].disabled = rail.scrollLeft <= 1
      buttons[1].disabled = rail.scrollLeft >= max - 1

      const visible = rail.scrollWidth > 0 ? rail.clientWidth / rail.scrollWidth : 1
      thumb.style.width = `${Math.min(visible, 1) * 100}%`
      thumb.style.transform = `translateX(${max > 0 ? (rail.scrollLeft / max) * (100 / Math.min(visible, 1) - 100) : 0}%)`
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const direction = Number(button.dataset.railStep ?? 1)
        rail.scrollBy({
          left: direction * step(),
          behavior: reduced.matches ? 'auto' : 'smooth',
        })
      })
    }

    let queued = false
    rail.addEventListener('scroll', () => {
      if (queued) return
      queued = true
      requestAnimationFrame(() => {
        queued = false
        sync()
      })
    })

    window.addEventListener('resize', sync)
    sync()
  }
</script>
