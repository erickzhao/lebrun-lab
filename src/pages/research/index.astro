---
import { getEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageIntro from '../../components/PageIntro.astro'
import { listedTopics } from '../../lib/research'

const info = await getEntry('pages', 'research')
const { title, subtitle } = info?.data ?? {}

const topics = await listedTopics()
---

<Base title={title} description={subtitle}>
  <PageIntro eyebrow="Research" title={title} subtitle={subtitle} />

  <section class="page band">
    <ul class="topics">
      {
        topics.map((topic, position) => (
          <li>
            <a class="quiet topic" href={`/research/${topic.id}/`}>
              <div class:list={['figure', { 'figure--empty': !topic.data.headerImage }]}>
                {topic.data.headerImage ? (
                  <img
                    src={topic.data.headerImage}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
              </div>
              <div class="topic-body">
                {/* The count is the reader's place in the list, so it is
                    decoration rather than content and stays out of the
                    accessibility tree along with the arrow beside it. */}
                <p class="topic-index" aria-hidden="true">
                  <span class="meta">{String(position + 1).padStart(2, '0')}</span>
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10h12M11 5l5 5-5 5" />
                  </svg>
                </p>
                <h2>{topic.data.title.trim()}</h2>
                {topic.data.subtitle && <p class="topic-sub">{topic.data.subtitle}</p>}
                {topic.data.tags && topic.data.tags.length > 0 && (
                  <p class="tags meta">
                    {topic.data.tags.map((tag, index) => (
                      <>
                        {index > 0 && <span class="sep">·</span>}
                        <span>{tag}</span>
                      </>
                    ))}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px 48px;
  }

  /*
   * A bordered card, so a topic reads as one object whether or not the
   * photograph behind it exists. The picture runs the full width of the card
   * and the words are inset from it, which is why they sit in their own box.
   */
  .topic {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg);
    overflow: hidden;
  }

  .topic:hover {
    border-color: var(--accent);
  }

  .topic-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 28px 28px;
  }

  .topic-index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    color: var(--accent);
  }

  .topic-index .meta {
    color: inherit;
  }

  .figure {
    width: 100%;
    height: clamp(200px, 26vw, 340px);
    background: var(--tile);
    overflow: hidden;
  }

  .figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .topic h2 {
    font-size: clamp(1.5rem, 1.32rem + 0.73vw, 1.75rem);
    line-height: 1.2;
    margin-top: 8px;
  }

  .topic-sub {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--slate);
  }

  .tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .sep {
    color: #b5b0a8;
  }

  @media (max-width: 900px) {
    .topics {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
