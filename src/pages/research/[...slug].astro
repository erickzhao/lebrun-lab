---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Attachments from '../../components/Attachments.astro'

export const getStaticPaths: GetStaticPaths = async () => {
  const topics = await getCollection('research')
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }))
}

interface Props {
  topic: CollectionEntry<'research'>
}

const { topic } = Astro.props
const { Content } = await render(topic)
const { title, subtitle, headerImage, tags, files } = topic.data
---

<Base title={title.trim()} description={subtitle}>
  {
    headerImage && (
      <div class="figure-wide">
        <img src={headerImage} alt="" fetchpriority="high" decoding="async" />
      </div>
    )
  }

  <header class="page page--measure post-head">
    <div>
      <p class="eyebrow meta">Research · Project</p>
      <h1>{title.trim()}</h1>
      {subtitle && <p class="post-sub">{subtitle}</p>}
      {
        tags && tags.length > 0 && (
          <p class="tags meta">
            {tags.map((tag, index) => (
              <>
                {index > 0 && <span class="sep">·</span>}
                <span>{tag}</span>
              </>
            ))}
          </p>
        )
      }
    </div>
  </header>

  <section class="page page--measure band">
    <div class="prose">
      <Content />
    </div>
    <Attachments files={files} />
  </section>
</Base>

<style>
  .post-head {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .post-head > div {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-head h1 {
    font-size: var(--size-title);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .post-sub {
    margin: 0;
    font-family: var(--display-family);
    font-size: clamp(1.25rem, 1.1rem + 0.64vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--slate);
  }

  .tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .sep {
    color: #b5b0a8;
  }
</style>
