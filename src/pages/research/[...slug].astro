---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Attachments from '../../components/Attachments.astro'
import PostNav from '../../components/PostNav.astro'
import { listedTopics } from '../../lib/research'

/*
 * Every topic still gets its own page, including the unlisted ones, but only
 * the listed ones form the sequence — stepping through here should not walk a
 * reader into a topic the Research page deliberately hides. An unlisted topic
 * is therefore not in the chain and offers no neighbours, only the way back.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const all = await getCollection('research')
  const listed = await listedTopics()

  return all.map((topic) => {
    const index = listed.findIndex((candidate) => candidate.id === topic.id)
    return {
      params: { slug: topic.id },
      props: {
        topic,
        previous: index === -1 ? undefined : listed[index - 1],
        next: index === -1 ? undefined : listed[index + 1],
      },
    }
  })
}

interface Props {
  topic: CollectionEntry<'research'>
  previous?: CollectionEntry<'research'>
  next?: CollectionEntry<'research'>
}

const { topic, previous, next } = Astro.props

const toLink = (entry?: CollectionEntry<'research'>) =>
  entry && { href: `/research/${entry.id}/`, title: entry.data.title.trim() }
const { Content } = await render(topic)
const { title, subtitle, headerImage, tags, files } = topic.data
---

<Base title={title.trim()} description={subtitle}>
  {
    headerImage && (
      <div class="figure-wide">
        <img src={headerImage} alt="" fetchpriority="high" decoding="async" />
      </div>
    )
  }

  <header class="page page--measure post-head">
    <div>
      <p class="eyebrow meta"><a href="/research/" class="back">← Research</a> · Project</p>
      <h1>{title.trim()}</h1>
      {subtitle && <p class="post-sub">{subtitle}</p>}
      {
        tags && tags.length > 0 && (
          <p class="tags meta">
            {tags.map((tag, index) => (
              <>
                {index > 0 && <span class="sep">·</span>}
                <span>{tag}</span>
              </>
            ))}
          </p>
        )
      }
    </div>
  </header>

  <section class="page page--measure band">
    <div class="prose">
      <Content />
    </div>
    <Attachments files={files} />
  </section>

  <PostNav
    previous={toLink(previous)}
    next={toLink(next)}
    labels={{ previous: 'Previous', next: 'Next' }}
  />
</Base>

<style>
  .post-head {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .post-head > div {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-head h1 {
    font-size: var(--size-title);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .post-sub {
    margin: 0;
    font-family: var(--display-family);
    font-size: clamp(1.25rem, 1.1rem + 0.64vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--slate);
  }

  .back {
    color: var(--slate);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .sep {
    color: #b5b0a8;
  }
</style>
