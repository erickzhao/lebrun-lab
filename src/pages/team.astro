---
import { getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageIntro from '../components/PageIntro.astro'
import TeamList from '../components/TeamList.astro'

const entry = await getEntry('pages', 'team')
if (!entry) throw new Error('Missing src/content/pages/team.md')

const { title, subtitle, members } = entry.data
const roster = members ?? []

// Every position the CMS offers has a heading here. Anyone whose position is
// not recognised still gets rendered, under a final group, so a member added
// through the CMS can never silently disappear from this page.
const groups: { key: string; label: string }[] = [
  { key: 'associate', label: 'Research Associates' },
  { key: 'postdoc', label: 'Post-Doctoral Fellows' },
  { key: 'grad', label: 'Graduate Students' },
  { key: 'masters', label: 'Masters Students' },
  { key: 'visiting', label: 'Visiting Scientists' },
  { key: 'assistant', label: 'Research Assistants' },
  { key: 'undergrad', label: 'Undergraduate Students' },
  { key: 'summer', label: 'Summer Students' },
  { key: 'admin', label: 'Administration' },
]

const known = new Set(groups.map((group) => group.key))
const sections = groups
  .map((group) => ({
    label: group.label,
    members: roster.filter((member) => member.position === group.key),
  }))
  .filter((section) => section.members.length > 0)

const unplaced = roster.filter((member) => !known.has(member.position))
if (unplaced.length > 0) {
  sections.push({ label: 'Other Lab Members', members: unplaced })
}
---

<Base title={title} description={subtitle}>
  <PageIntro eyebrow="Lab" title={title} subtitle={subtitle} />

  <div class="page band groups">
    {
      sections.map((section) => (
        <section class="group">
          <h2 class="tinted-heading">{section.label}</h2>
          <TeamList members={section.members} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 2rem + 3vw, 5.5rem);
  }

  /* The heading draws the rule that opens each group. */
  .group {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .group h2 {
    font-size: var(--size-card);
  }
</style>
