---
import { marked } from 'marked'

interface Member {
  name: string
  position: string
  photo?: string
  description?: string
  email?: string
}

interface Props {
  members: Member[]
}

const { members } = Astro.props

/**
 * Most of the roster is a name and nothing else, so a member without a photo
 * gets an initials tile of the same 4:5 proportion rather than a stretched
 * placeholder. Roles and honorifics are written into the `name` field in the
 * CMS ("Thomas Kucharski - CRP Program Manager", "Yizhou Zhang, MD, Ph.D.
 * Candidate"), so take the initials from the part before them.
 */
function initials(name: string): string {
  const bare = name
    .split(' - ')[0]
    .split(',')[0]
    .replace(/^(dr|prof|mr|ms|mrs)\.?\s+/i, '')
    .trim()

  return bare
    .split(/\s+/)
    .filter((word) => /[\p{L}]/u.test(word))
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('')
}
---

<ul class="roster">
  {
    members.map((member) => {
      const email = member.email?.trim()
      const bio = member.description?.trim()
      return (
        <li class="member">
          {member.photo ? (
            <div class="portrait">
              <img src={member.photo} alt={member.name} loading="lazy" decoding="async" />
            </div>
          ) : (
            <div class="portrait portrait--initials" aria-hidden="true">
              <span>{initials(member.name)}</span>
            </div>
          )}

          <h3>{member.name}</h3>
          {email && (
            <a class="member-email" href={`mailto:${email}`}>
              {email}
            </a>
          )}
          {bio && (
            <div class="member-bio">
              <div class="bio-text prose" set:html={marked.parse(bio)} />
              <button type="button" class="text-button bio-toggle" hidden>
                More
              </button>
            </div>
          )}
        </li>
      )
    })
  }
</ul>

<style>
  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px 32px;
  }

  .member {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .member h3 {
    font-size: 1.25rem;
    line-height: 1.25;
    margin-top: 14px;
  }

  .member-email {
    font-size: 0.8125rem;
    margin-top: 8px;
    align-self: flex-start;
    overflow-wrap: anywhere;
  }

  .member-bio {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bio-text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--slate);
  }

  /*
   * Two labelled facts rather than a bulleted list: at this width the markers
   * and their indent only take room away from the text beside them.
   */
  .bio-text :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .bio-text :global(li + li) {
    margin-top: 0.4rem;
  }

  /*
   * Biographies run to wildly different lengths and clamping them is what
   * keeps the grid even. The script below applies this class, rather than the
   * stylesheet keying off a class on <html>: that way the clamp exists only
   * where the toggle that undoes it does, and it still works when the page is
   * rendered inside another document, where nothing set on
   * document.documentElement ever reaches this element.
   *
   * A max-height rather than -webkit-line-clamp, because the content is a list
   * and line clamping does not reliably cross block children.
   */
  .bio-text.is-clamped:not(.is-open) {
    max-height: 4.65em; /* three lines at the line-height above */
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 16px;
    }
  }
</style>

<script>
  for (const wrapper of document.querySelectorAll<HTMLElement>('.member-bio')) {
    const text = wrapper.querySelector<HTMLElement>('.bio-text')
    const toggle = wrapper.querySelector<HTMLButtonElement>('.bio-toggle')
    if (!text || !toggle) continue

    text.classList.add('is-clamped')

    // Nothing is being hidden if the biography is short enough to fit.
    if (text.scrollHeight <= text.clientHeight + 1) {
      text.classList.remove('is-clamped')
      continue
    }

    toggle.hidden = false
    toggle.addEventListener('click', () => {
      const open = text.classList.toggle('is-open')
      toggle.textContent = open ? 'Less' : 'More'
    })
  }
</script>
