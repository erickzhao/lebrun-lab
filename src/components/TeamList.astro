---
import { marked } from 'marked'

interface Member {
  name: string
  position: string
  photo?: string
  description?: string
  email?: string
}

interface Props {
  members: Member[]
}

const { members } = Astro.props

/**
 * Only some of the roster has sent a photograph, and most of the rest is a
 * name and nothing else. A card is the right shape for a portrait and a
 * biography, and the wrong one for a name: a grid of mostly empty tiles reads
 * as a page waiting for content. So each group shows its photographed members
 * as cards and lists everyone else in a compact row, in the CMS order within
 * each. A member who adds a photo through the CMS moves up into the cards.
 */
const trim = (value?: string) => value?.trim() || undefined
const pictured = members.filter((member) => member.photo)
const listed = members.filter((member) => !member.photo)
---

{
  pictured.length > 0 && (
    <ul class="roster">
      {pictured.map((member) => {
        const email = trim(member.email)
        const bio = trim(member.description)
        return (
          <li class="member">
            <div class="portrait">
              <img src={member.photo} alt={member.name} loading="lazy" decoding="async" />
            </div>

            <div class="member-body">
              <h3>{member.name}</h3>
              {email && (
                <a class="member-email" href={`mailto:${email}`}>
                  {email}
                </a>
              )}
              {bio && (
                <div class="member-bio">
                  <div class="bio-text prose" set:html={marked.parse(bio)} />
                  <button type="button" class="text-button bio-toggle" hidden>
                    More
                  </button>
                </div>
              )}
            </div>
          </li>
        )
      })}
    </ul>
  )
}

{
  listed.length > 0 && (
    <ul class="names">
      {listed.map((member) => {
        const email = trim(member.email)
        const bio = trim(member.description)
        return (
          <li class="person">
            <h3>{member.name}</h3>
            {email && (
              <a class="member-email" href={`mailto:${email}`}>
                {email}
              </a>
            )}
            {bio && <div class="person-bio bio-text prose" set:html={marked.parse(bio)} />}
          </li>
        )
      })}
    </ul>
  )
}

<style>
  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  /*
   * The same bordered card the homepage rail uses, so a person and a research
   * topic are the same kind of object. The portrait runs to the card's edges
   * and the words are inset from it. It is not a link, so it has no hover.
   */
  .member {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg);
    overflow: hidden;
  }

  .member :global(.portrait) {
    border-radius: 0;
  }

  .member-body {
    display: flex;
    flex-direction: column;
    padding: 0 20px 24px;
    flex-grow: 1;
  }

  .member h3,
  .person h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .member h3 {
    margin-top: 14px;
  }

  .member-email {
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .member .member-email {
    margin-top: 8px;
    align-self: flex-start;
  }

  .member-bio {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bio-text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--slate);
  }

  /*
   * Two labelled facts rather than a bulleted list: at this width the markers
   * and their indent only take room away from the text beside them.
   */
  .bio-text :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .bio-text :global(li + li) {
    margin-top: 0.4rem;
  }

  /*
   * Biographies run to wildly different lengths and clamping them is what
   * keeps the grid even. The script below applies this class, rather than the
   * stylesheet keying off a class on <html>: that way the clamp exists only
   * where the toggle that undoes it does, and it still works when the page is
   * rendered inside another document, where nothing set on
   * document.documentElement ever reaches this element.
   *
   * A max-height rather than -webkit-line-clamp, because the content is a list
   * and line clamping does not reliably cross block children. The clamp is a
   * whole number of lines, so the gap between facts goes while it is on —
   * otherwise the cut lands through the middle of the third line.
   */
  .bio-text.is-clamped:not(.is-open) {
    max-height: 4.65em; /* three lines at the line-height above */
    overflow: hidden;
  }

  .bio-text.is-clamped:not(.is-open) :global(li + li) {
    margin-top: 0;
  }

  /* ------------------------------------------------- members without a photo */

  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .person {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 2rem;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .person-bio {
    grid-column: 1 / -1;
    margin-top: 8px;
    max-width: var(--measure);
  }

  @media (max-width: 900px) {
    .roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .member-body {
      padding: 0 14px 18px;
    }
  }

  @media (max-width: 600px) {
    .person {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
    }
  }
</style>

<script>
  for (const wrapper of document.querySelectorAll<HTMLElement>('.member-bio')) {
    const text = wrapper.querySelector<HTMLElement>('.bio-text')
    const toggle = wrapper.querySelector<HTMLButtonElement>('.bio-toggle')
    if (!text || !toggle) continue

    text.classList.add('is-clamped')

    // Nothing is being hidden if the biography is short enough to fit.
    if (text.scrollHeight <= text.clientHeight + 1) {
      text.classList.remove('is-clamped')
      continue
    }

    toggle.hidden = false
    toggle.addEventListener('click', () => {
      const open = text.classList.toggle('is-open')
      toggle.textContent = open ? 'Less' : 'More'
    })
  }
</script>
