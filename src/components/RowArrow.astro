---
/**
 * The arrow at the end of a row or card that is itself a link.
 *
 * It repeats what the row already says, so it is decoration: hidden from
 * assistive software, and coloured by whatever it sits in rather than
 * carrying the accent itself.
 */
---

<svg
  class="row-arrow"
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M4 10h12M11 5l5 5-5 5"></path>
</svg>

<style>
  /* The row or card it sits in moves it on hover; the ease-out is the
     movement's own, so every arrow on the site travels the same way. */
  .row-arrow {
    display: block;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
</style>
