---
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="footer-inner">
    <div class="affiliations">
      <p class="affiliation">
        Cancer Research Program
        <span>Research Institute of the McGill University Health Centre</span>
      </p>
      <span class="divider" aria-hidden="true"></span>
      <p class="affiliation">
        McGill University
        <span>Faculty of Medicine and Health Sciences</span>
      </p>
    </div>

    <div class="colophon">
      <p>
        For donations, please contact Dr. Lebrun at{' '}
        <a href="mailto:jj.lebrun@mcgill.ca">jj.lebrun@mcgill.ca</a>. Thank you for your support.
      </p>
      <p>Copyright &copy; {year} Lebrun Lab. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-2);
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 48px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .affiliations {
    display: flex;
    gap: 40px;
    align-items: center;
    flex-wrap: wrap;
  }

  .affiliation {
    margin: 0;
    font-family: var(--display-family);
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .affiliation span {
    display: block;
    font-family: var(--body-family);
    font-size: 0.875rem;
    color: var(--slate);
  }

  .divider {
    width: 1px;
    height: 40px;
    background: var(--rule);
  }

  .colophon {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 0.8125rem;
    color: var(--slate);
    line-height: 1.6;
  }

  .colophon p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .divider {
      display: none;
    }

    .colophon {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
