---
interface Props {
  title?: string
  subtitle?: string
  image?: string
}

const { title, subtitle, image } = Astro.props

// Image paths come from the CMS and may contain spaces, so encode before
// dropping them into a CSS url().
const style = image
  ? `background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url("${encodeURI(image)}");`
  : undefined
---

<header class="hero is-medium is-primary page-header" style={style}>
  <div class="hero-body">
    <div class="container has-text-centered">
      <h1 class="title is-1">{title}</h1>
      {subtitle && <h2 class="subtitle">{subtitle}</h2>}
    </div>
  </div>
</header>
