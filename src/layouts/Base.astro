---
import '../styles/global.css'

import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

import favicon32 from '../assets/favicon-32x32.png'
import favicon256 from '../assets/favicon-256x256.png'
import favicon512 from '../assets/favicon-512x512.png'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
const pageTitle = title ? `${title} - Lebrun Lab` : 'Lebrun Lab'
const canonical = new URL(Astro.url.pathname, Astro.site)

/*
 * A meta description is a search-result snippet, and a few posts carry their
 * whole article in the field this comes from. Search engines cut it off around
 * 160 characters anyway, so it is trimmed here on a word boundary rather than
 * mid-word. The page itself still shows the text in full.
 */
const META_MAX = 160
const flat = description?.replace(/\s+/g, ' ').trim()
const metaDescription =
  flat && flat.length > META_MAX
    ? flat.slice(0, flat.lastIndexOf(' ', META_MAX - 1)).replace(/[,;:.]$/, '') + '…'
    : flat
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="256x256" href={favicon256.src} />
    <link rel="icon" type="image/png" sizes="512x512" href={favicon512.src} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Manrope:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <!-- Progressive enhancements (the clamped team biographies) only apply
         when their toggle is actually reachable. -->
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
    </script>

    <!-- A diagram cropped to a frame loses its labels, so one is shown whole:
         a picture much wider than its card is contained rather than cropped,
         and a banner-shaped picture at the head of a page takes its own
         height. A picture taller than its frame is still cropped, since that
         is a photograph losing some sky. Load events do not bubble, so this
         listens in the capture phase and catches every image on the page, lazy
         ones included. -->
    <script is:inline>
      document.addEventListener(
        'load',
        function (event) {
          var img = event.target
          if (!(img instanceof HTMLImageElement) || !img.naturalWidth) return
          var frame = img.closest('.figure, .topic-figure, .figure-wide')
          if (!frame || !frame.clientHeight) return
          var picture = img.naturalWidth / img.naturalHeight
          if (frame.classList.contains('figure-wide')) {
            frame.classList.toggle('is-banner', picture >= 1.8)
            return
          }
          var box = frame.clientWidth / frame.clientHeight
          frame.classList.toggle('is-contained', picture / box > 1.2)
        },
        true
      )
    </script>
  </head>
  <body>
    <!--
      Netlify Identity invitation, recovery and confirmation links land on the
      site root carrying a token in the URL fragment. Only then is the widget
      worth loading, so ordinary visitors never pay for it.
    -->
    <script is:inline>
      ;(function () {
        var hash = window.location.hash
        if (!/\b(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(hash)) {
          return
        }
        var script = document.createElement('script')
        script.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js'
        script.onload = function () {
          var identity = window.netlifyIdentity
          if (!identity) return
          identity.on('init', function (user) {
            if (!user) {
              identity.on('login', function () {
                window.location.href = '/admin/'
              })
            }
          })
          identity.init()
        }
        document.head.appendChild(script)
      })()
    </script>

    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1 0 auto;
  }
</style>
