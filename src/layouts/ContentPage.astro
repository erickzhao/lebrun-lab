---
import { getEntry, render } from 'astro:content'
import Base from './Base.astro'
import PageHeader from '../components/PageHeader.astro'

interface Props {
  id: string
}

const { id } = Astro.props
const entry = await getEntry('pages', id)

if (!entry) {
  throw new Error(`No page content found for "${id}" in src/content/pages.`)
}

const { Content } = await render(entry)
const { title, subtitle, headerImage } = entry.data
---

<Base title={title} description={subtitle}>
  <PageHeader title={title} subtitle={subtitle} image={headerImage} />
  <section class="section">
    <div class="container body">
      <div class="content">
        <Content />
      </div>
    </div>
  </section>
</Base>
