---
import { getEntry, render } from 'astro:content'
import Base from './Base.astro'
import PageIntro from '../components/PageIntro.astro'

interface Props {
  id: string
  /** Small label above the title, naming the section this page sits in. */
  eyebrow?: string
  /** `citations` styles a flat bullet list as a run of reference rows. */
  variant?: 'prose' | 'citations'
}

const { id, eyebrow, variant = 'prose' } = Astro.props
const entry = await getEntry('pages', id)

if (!entry) {
  throw new Error(`No page content found for "${id}" in src/content/pages.`)
}

const { Content } = await render(entry)
const { title, subtitle } = entry.data
---

<Base title={title} description={subtitle}>
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    subtitle={subtitle}
    displaySubtitle={variant === 'citations'}
    measure
  />
  <section class="page page--measure band">
    <div class:list={['prose', { 'prose--citations': variant === 'citations' }]}>
      <Content />
    </div>
  </section>
</Base>
